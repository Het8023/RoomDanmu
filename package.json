        "typecheck": "npm run typecheck:node && npm run typecheck:web"
    },
    "dependencies": {
        "vue": "^3.5.13"
    },
    "devDependencies": {
        "@types/node": "^22.10.5",
        "@vitejs/plugin-vue": "^5.2.1",
        "electron": "^36.2.0",
        "electron-vite": "^3.1.0",
        "typescript": "^5.7.3",
        "vite": "^6.0.7"
    }
}
