{
    "name": "lan-danmaku",
    "version": "0.1.0",
    "description": "局域网桌面弹幕房间：全局热键输入，弹幕飘过同房间成员桌面",
    "main": "./out/main/index.js",
    "license": "MIT",
    "scripts": {
        "test": "node --test tests/*.test.cjs",
        "dev": "electron-vite dev",
